# MongoDB Atlas connection string. Leave unset locally to use an in-memory DB.
MONGODB_URI=

# The single admin login, created on first boot if no user exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs session tokens. Use a long random string: openssl rand -hex 32
JWT_SECRET=

# Set to false to stop auto-seeding demo data into an empty database.
SEED_DEMO=true
