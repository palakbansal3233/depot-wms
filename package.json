{
  "name": "depot-wms",
  "version": "1.0.0",
  "description": "Supply Depot WMS — 10-minute issue control board",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node server/seed/run.js"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "mongoose": "^9.10.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^8.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
